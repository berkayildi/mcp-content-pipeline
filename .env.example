# Copy to .env; loaded from the working directory, or from MCP_CP_ENV_FILE if set

# === Required ===

# Text-analysis driver: anthropic|openai — pick one, set a matching model + key
MCP_CP_PIPELINE_PROVIDER=anthropic
MCP_CP_PIPELINE_MODEL=claude-sonnet-4-6
MCP_CP_PIPELINE_API_KEY=sk-ant-your-key-here

# GitHub personal access token used to push synced content to your repo (sync_to_github)
MCP_CP_GITHUB_TOKEN=github_pat_your-token-here

# Target GitHub repo for synced content, in owner/repo format (sync_to_github)
MCP_CP_GITHUB_REPO=your-username/your-repo

# X (Twitter) API v2 bearer token for fetching posts from curated accounts (analyse_x_feed)
MCP_CP_X_BEARER_TOKEN=your-x-bearer-token

# === Optional ===

# Branch to push synced content to (default: main)
MCP_CP_GITHUB_BRANCH=main

# Output directory (in the target repo) for YouTube analyses (default: content/youtube)
MCP_CP_GITHUB_OUTPUT_DIR=content/youtube

# Output directory (in the target repo) for X digests (default: content/x-digest)
MCP_CP_GITHUB_X_OUTPUT_DIR=content/x-digest

# Max transcript length in tokens before truncation (default: 100000)
MCP_CP_MAX_TRANSCRIPT_TOKENS=100000

# Comma-separated X/Twitter usernames to analyse by default
MCP_CP_X_ACCOUNTS=karpathy,bcherny,atmoio

# Comma-separated topics to focus the X digest on (default: AI,tech)
MCP_CP_X_TOPICS=AI,tech
