# Anthropic API key used for Claude-based analysis (analyse_video, analyse_x_feed)
MCP_CP_ANTHROPIC_API_KEY=sk-ant-your-key-here

# X (Twitter) API v2 bearer token for fetching posts from curated accounts
MCP_CP_X_BEARER_TOKEN=your-x-bearer-token

# Comma-separated X/Twitter usernames to analyse by default
MCP_CP_X_ACCOUNTS=karpathy,bcherny,atmoio

# Comma-separated topics to focus the X digest on (default: AI,tech)
MCP_CP_X_TOPICS=AI,tech

# GitHub personal access token used to push synced content to your repo
MCP_CP_GITHUB_TOKEN=github_pat_your-token-here

# Target GitHub repo for synced content, in owner/repo format
MCP_CP_GITHUB_REPO=your-username/your-repo

# Branch to push synced content to (default: main)
MCP_CP_GITHUB_BRANCH=main

# Claude model used for analysis (default: claude-sonnet-4-6)
MCP_CP_CLAUDE_MODEL=claude-sonnet-4-6
